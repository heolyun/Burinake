# Backend ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# PostgreSQL
POSTGRES_DB=burinake
POSTGRES_USER=burinake
POSTGRES_PASSWORD=burinake_dev_password
POSTGRES_PORT=5432

# Azure Storage
# Azure Storage Account connection string.
# Use a real Storage Account connection string for Azure.
# The dev compose file already falls back to Azurite when this is empty.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=fire-events

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=Burinake-vlm
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_MAX_COMPLETION_TOKENS=4000

# AI service URLs
AI_YOLO_BASE_URL=http://yolo-server:8001
AI_VLM_BASE_URL=http://vlm-server:8002
